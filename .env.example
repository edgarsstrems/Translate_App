# ==============================================================================
# Church Sermon Translator Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gemini AI Translation (quotas/pricing depend on your account)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Options:
# - gemini-flash-latest       (Recommended - Auto-Updating Latest Fast Model)
# - gemini-flash-lite-latest  (High Speed, 30 RPM)
# - gemini-3.5-flash-lite     (Fast & Efficient)
# - gemini-3.5-flash          (Balanced)
# - gemini-3.6-flash          (Advanced Reasoning)
GEMINI_MODEL=auto

# Translation provider: "gemini" (recommended) or "auto" (falls back to free instant web translate)
TRANSLATION_PROVIDER=gemini

# Free Tier Optimization Mode: translates EN + RU jointly in a single API call
FREE_TIER_MODE=true

# ------------------------------------------------------------------------------
# 2. Speech Recognition (STT)
# ------------------------------------------------------------------------------
# Backend: "openai" (Cloud API - fast & accurate) or "local" (Faster-Whisper on PC)
SPEECH_RECOGNITION_BACKEND=openai

# OpenAI API Key (Required if SPEECH_RECOGNITION_BACKEND=openai - Whisper is the only paid service ~$0.006/min)
OPENAI_API_KEY=

# OpenAI STT Model: "gpt-4o-transcribe" (recommended for Latvian), "gpt-4o-mini-transcribe", or "whisper-1"
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Local Whisper settings (Used if SPEECH_RECOGNITION_BACKEND=local)
# Model size: "large-v3-turbo" (Recommended - Best Accuracy & Speed), "medium", "large-v3", "small"
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_BEAM_SIZE=3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_VAD_FILTER=false
WHISPER_HOTWORDS=
# Quality mode: "balanced", "live", "accuracy"
WHISPER_QUALITY_MODE=balanced
WHISPER_MIN_RMS=0.0

# ------------------------------------------------------------------------------
# 3. Google Cloud Text-to-Speech (intended speech provider)
# ------------------------------------------------------------------------------
# Path to Google Service Account JSON for Google Cloud Text-to-Speech
# (If not provided, the app uses built-in instant free speech synthesis)
GOOGLE_APPLICATION_CREDENTIALS=credentials\google-service-account.json

# Voice names for Google Cloud TTS
TTS_ENGLISH_VOICE=en-US-Standard-J
TTS_RUSSIAN_VOICE=ru-RU-Standard-D
TTS_LITHUANIAN_VOICE=lt-LT-Standard-B

# ------------------------------------------------------------------------------
# 4. Audio Capture & Latency Tuning
# ------------------------------------------------------------------------------
# Dynamic chunk duration in seconds (5s max ceiling, 2.5s dynamic min, 0.45s natural sentence pause)
CHUNK_SECONDS=5.0
MIN_CHUNK_SECONDS=2.5
EARLY_FLUSH_SILENCE_SECONDS=0.45
CHUNK_OVERLAP_SECONDS=0.0

# Smart sentence continuity: provides previous-clause context without waiting for another chunk
SMART_SENTENCE_STITCHING=true

# Energy thresholds choose pause boundaries; captured quiet speech is retained.
# Legacy VAD filtering/minimum-duration fields are retained for configuration compatibility.
VAD_ENABLED=true
VAD_RMS_THRESHOLD=0.004
VAD_PEAK_THRESHOLD=0.025
VAD_MIN_SPEECH_SECONDS=0.20
VAD_MIN_SPEECH_RATIO=0.03
VAD_PADDING_SECONDS=0.50

# Backlog warning thresholds; queues persist on disk and never discard old speech.
# Legacy age limits are retained for compatibility, not used to expire speech.
MAX_AUDIO_QUEUE_SIZE=2
MAX_TRANSLATION_QUEUE_SIZE=6
MAX_CHUNK_AGE_SECONDS=45
MAX_TTS_AGE_SECONDS=60
SAVE_DEBUG_AUDIO=false
